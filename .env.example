# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# Test-mode keys only. MILAAN refuses to run against a key starting rzp_live_
# — see scripts/check_keys.py. There is no reason this project ever touches a
# live key, and a hard stop is cheaper than remembering not to.
#
# Dashboard -> Test Mode toggle -> Account & Settings -> API Keys -> Generate Test Key
# The secret is shown exactly once. Download the key details before closing.

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
